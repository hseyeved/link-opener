{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Link Opener",
  "version": "0.2.0",
  "identifier": "com.devistry.linkopener",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Link Opener",
        "width": 1000,
        "height": 680,
        "minWidth": 640,
        "minHeight": 400,
        "dragDropEnabled": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/favicons/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
